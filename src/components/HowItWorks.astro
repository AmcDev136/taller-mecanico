---
import { pasos } from "../data/site";
---
<section id="como-funciona" class="mx-auto max-w-5xl px-4 py-20">
    <h2 class="text-center text-3xl font-bold">¿Cómo funciona?</h2>
    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pasos.map((p, i) => (
            <li class="text-center">
                <div class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-naranja text-xl font-bold text-white">
                    {i + 1}
                </div>
                <h3 class="mt-3 font-semibold">{p.titulo}</h3>
                <p class="mt-1 text-carbon/75">{p.texto}</p>
            </li>
        ))}
    </ol>
</section>