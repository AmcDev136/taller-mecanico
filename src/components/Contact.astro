---
import { site, whatsappLink } from "../data/site";
import CitaForm from "./CitaForm.astro";
---
<section id="contacto" class="bg-carbon py-20 text-crema">
    <div class="mx-auto max-w-3xl px-4 text-center">
        <h2 class="text-3xl font-bold">¿Listo para agendar?</h2>
        <p class="mt-3 text-crema/80">Llena tus datos y te responderemos por WhatsApp.</p>

        <CitaForm />

        <p class="mt-8 text-crema/70">
            ¿Prefieres escribir directo?
            <a 
                href={whatsappLink("Hola, quiero agendar una cita.")}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-naranja-vivo underline hover:text-white"
            >
                Abrir chat
            </a>
        </p>

        <p class="mt-6 text-sm text-crema/70">{site.city}</p>
    </div>
</section>